# Keep the build context small and secrets out of the image.

# Dependencies / build output (rebuilt inside the image)
node_modules
.next
npm-debug.log*

# Local env files — never bake secrets into an image.
# Env is provided via Render env vars / --build-arg instead.
.env
.env.*

# Git metadata
.git
.gitignore
.gitattributes

# Deployment plumbing (not needed inside the image)
Dockerfile
.dockerignore
render.yaml
README.md

# Supabase migrations run against the Supabase project, not this image
supabase

# Local tooling, docs, and scratch files
scripts
dev-log.txt
tsconfig.tsbuildinfo
next-env.d.ts
CLAUDE.md
AGENTS.md
psych-platform-lean-mvp-plan.md